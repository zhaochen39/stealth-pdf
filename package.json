{
  "name": "stealth-pdf",
  "version": "1.0.0",
  "description": "A Windows PDF reader that stays hidden until you hold a trigger key with the cursor over it. 按住触发键并把光标移到窗口上才显示的 Windows PDF 阅读器。",
  "keywords": [
    "pdf",
    "pdf-reader",
    "pdf-viewer",
    "electron",
    "windows",
    "tabs",
    "annotation",
    "stealth"
  ],
  "homepage": "https://github.com/YOUR_GITHUB_USERNAME/stealth-pdf#readme",
  "bugs": {
    "url": "https://github.com/YOUR_GITHUB_USERNAME/stealth-pdf/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_GITHUB_USERNAME/stealth-pdf.git"
  },
  "license": "MIT",
  "author": "StealthPDF contributors",
  "private": true,
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "check": "node --check main.js && node --check preload.js && node --check annotate.js && node --check pageops.js && node --check trigger.js && node --check renderer/renderer.js && node --check renderer/ribbon.js && node --check renderer/sidebar.js && node --check renderer/dialogs.js && node --check renderer/icons.js",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win",
    "dist:zip": "electron-builder --win zip",
    "icons": "python3 tools/make_icons.py"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.stealthpdf.app",
    "productName": "StealthPDF",
    "copyright": "Copyright © 2026 StealthPDF contributors",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "annotate.js",
      "pageops.js",
      "trigger.js",
      "renderer/**/*",
      "build/icon.png",
      "build/tray.png",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "${productName}-${version}-win-x64.${ext}",
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF Document",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StealthPDF",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
